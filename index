function bearSvg(color='#c7a8d7'){return `<svg viewBox="0 0 120 150" aria-hidden="true"><ellipse cx="60" cy="140" rx="35" ry="7" fill="#b3a49844"/><path d="M36 91Q26 95 26 120L35 124L34 142H50L56 122H64L70 142H86L85 123L94 119Q94 96 82 91Z" fill="${color}" stroke="#826c7c" stroke-width="2"/><path d="M45 94H75L78 121H42Z" fill="#fff5df"/><circle cx="30" cy="29" r="17" fill="#c6a17f" stroke="#9c7c65" stroke-width="2"/><circle cx="90" cy="29" r="17" fill="#c6a17f" stroke="#9c7c65" stroke-width="2"/><circle cx="30" cy="29" r="9" fill="#e8c1ae"/><circle cx="90" cy="29" r="9" fill="#e8c1ae"/><ellipse cx="60" cy="57" rx="43" ry="39" fill="#d8b692" stroke="#9c7c65" stroke-width="2"/><ellipse cx="60" cy="69" rx="20" ry="14" fill="#f4dfbc"/><circle cx="44" cy="54" r="3.5" fill="#5e4b47"/><circle cx="76" cy="54" r="3.5" fill="#5e4b47"/><ellipse cx="60" cy="65" rx="5" ry="4" fill="#6f5650"/><path d="M60 69V73M53 73Q60 80 67 73" stroke="#6f5650" stroke-width="2" fill="none" stroke-linecap="round"/><ellipse cx="34" cy="66" rx="8" ry="4" fill="#e4a3a1"/><ellipse cx="86" cy="66" rx="8" ry="4" fill="#e4a3a1"/><path d="M24 42Q35 15 64 16Q89 18 99 42Z" fill="${color}"/><path d="M43 25H75" stroke="#fff8e6" stroke-width="5" stroke-linecap="round"/></svg>`}
function plantSvg(){return '<svg viewBox="0 0 80 120" aria-hidden="true"><path d="M40 82V25" stroke="#81a47d" stroke-width="5"/><path d="M40 53Q8 51 11 25Q39 26 40 53M40 70Q69 65 68 40Q42 39 40 70M40 34Q25 14 42 5Q59 16 40 34" fill="#a4c5a0" stroke="#81a47d" stroke-width="2"/><path d="M17 78H64L57 113H24Z" fill="#e8ab96" stroke="#c98c7f" stroke-width="2"/><rect x="14" y="75" width="53" height="10" rx="4" fill="#f0c1aa" stroke="#c98c7f" stroke-width="2"/><path d="M32 90H48" stroke="#f9ddc9" stroke-width="4" stroke-linecap="round"/></svg>'}
function updateStats(){$('coins').textContent=saved.coins;$('served').textContent=game.served+' / 5';$('stars').textContent=game.served;$('plantSlot').innerHTML=saved.plant?'<div class="plant">'+plantSvg()+'</div>':''}
function renderShelves(){$('shelves').innerHTML=products.map(p=>`<button class="product" onclick="addItem('${p.id}')" aria-label="添加${p.zh}，每${p.unit}${p.price}元" ${game.stage!=='pack'?'disabled':''}>${productSvg(p.id)}<span class="name">${p.zh}</span><span class="price">¥${p.price} / ${p.unit}</span>${game.cart[p.id]?'<span class="quantity">'+game.cart[p.id]+'</span>':''}</button>`).join('')}
function total(items){return products.reduce((sum,p)=>sum+(items[p.id]||0)*p.price,0)}function itemText(items){return products.filter(p=>items[p.id]).map(p=>({1:'一',2:'两',3:'三',4:'四',5:'五'}[items[p.id]]||items[p.id])+p.unit+p.zh).join('、')}
function feedbackHtml(){return '<div class="feedback '+(game.good?'good':'')+'" role="status" aria-live="polite">'+game.feedback+'</div>'}
function render(){updateStats();renderShelves();document.querySelector('.register').dataset.amount='¥ '+(game.active?total(game.stage==='pack'?game.cart:orders[game.index].items):0).toFixed(2);if(game.stage==='welcome'){renderWelcome();return}if(game.stage==='done'){renderDone();return}const o=orders[game.index];$('customer').innerHTML=bearSvg(o.color);$('speech').textContent=game.stage==='reward'?'谢谢你，下次再来！':o.zh;$('shopHint').innerHTML=game.stage==='pack'?'✦ <b>点击货架取货</b> · 点购物篮中的 − 可以放回':game.stage==='pay'?'✦ <b>算一算，一共多少钱？</b>':game.stage==='reply'?'✦ <b>选一句礼貌的回应</b>':'✦ <b>又完成了一份中文小任务！</b>';
let body=`<div class="panel-title"><h2>今日的小订单</h2><span class="day-label">顾客 ${game.index+1} / 5</span></div><div class="steps">${['配货','收款','送客'].map((s,i)=>'<span class="step '+(['pack','pay','reply'][i]===game.stage?'on':'')+'">'+(i+1)+' '+s+'</span>').join('')}</div><div class="order"><div class="order-name">${o.name} 的购物心愿</div><div class="order-zh">${o.zh}</div>${game.py?'<div class="support">'+o.py+'</div>':''}${game.th?'<div class="support thai">'+o.th+'</div>':''}<div class="help-row"><button class="tiny" onclick="toggleHelp('py')" aria-pressed="${game.py}">${game.py?'隐藏':'显示'}拼音</button><button class="tiny" onclick="toggleHelp('th')" aria-pressed="${game.th}">${game.th?'隐藏':'显示'}泰语提示</button></div></div>`;
if(game.stage==='pack')body+=`<div class="basket-title"><strong>小小购物篮</strong><button class="tiny" onclick="clearCart()">放回全部</button></div><div class="basket">${basketHtml()}</div><div class="subtotal">购物篮合计 <strong>¥ ${total(game.cart)}</strong></div>${feedbackHtml()}<button class="primary" onclick="checkCart()">打包好了，去收银 →</button>`;
if(game.stage==='pay'){const t=total(o.items);body+=`<p>商品已配齐。应该收多少钱？</p><div class="choices">${(game.index%3===0?[t,t+2,t+5]:game.index%3===1?[t+2,t+5,t]:[t+2,t,t+5]).map(n=>`<button class="choice" onclick="pay(${n})">一共${n}块钱。</button>`).join('')}</div>${feedbackHtml()}`}
if(game.stage==='reply')body+='<p>顾客：谢谢你！你应该怎么回答？</p><div class="choices"><button class="choice" onclick="reply(0)">我要一个顾客。</button><button class="choice" onclick="reply(1)">不客气，欢迎下次再来！</button><button class="choice" onclick="reply(2)">你是八块钱。</button></div>'+feedbackHtml();
if(game.stage==='reward')body+=`<div class="welcome flying"><div class="stars">★</div><h3>这一单，完成啦！</h3><div class="reward">+10 金币</div><p>你读懂了订单，也完成了礼貌送客。</p><div class="review-card">我要${itemText(o.items)}。<br>一共${total(o.items)}块钱。<br>不客气，欢迎下次再来！</div><button class="primary" onclick="nextCustomer()">${game.index===4?'打烊啦，看看今天的收获':'迎接下一位顾客 →'}</button></div>`;
body+='<div class="panel-bottom">慢慢来，没有倒计时。答错也可以再试一次 ♡</div>';$('panel').innerHTML=body}
function basketHtml(){const active=products.filter(p=>game.cart[p.id]);return active.length?active.map(p=>`<div class="basket-row">${productSvg(p.id)}<span>${p.zh}</span><span>× ${game.cart[p.id]}</span><button class="minus" onclick="removeItem('${p.id}')" aria-label="放回一${p.unit}${p.zh}">−</button></div>`).join(''):'<div class="empty">购物篮还是空的<br>点货架上的商品，帮顾客装好吧</div>'}
function renderWelcome(){$('customer').innerHTML=bearSvg();$('speech').textContent='你好，小店长！';$('panel').innerHTML=`<div class="panel-title"><h2>你的中文小店，开张啦</h2><span class="day-label">营业准备</span></div><div class="welcome"><div class="large-bear">${bearSvg()}</div><h3>今天，你是小店长。</h3><p>รับออร์เดอร์ หยิบสินค้า คิดเงิน<br>ฝึกภาษาจีนผ่านร้านเล็ก ๆ ของเรา</p><div class="instruction"><b>1</b><span>读顾客订单，点击货架配货</span></div><div class="instruction"><b>2</b><span>算好总价，用中文收款</span></div><div class="instruction"><b>3</b><span>礼貌送客，赚金币装扮小店</span></div><button class="primary" onclick="startDay()">开始营业 ✦</button></div><div class="panel-bottom">五位顾客 · 六种商品 · 一场轻松的中文练习</div>`}
function startDay(){game={active:true,index:0,stage:'pack',cart:{},served:0,errors:0,py:false,th:false,feedback:'',good:false};render();$('announce').textContent='开始营业。第一位顾客来了。'}
function addItem(id){if(game.stage!=='pack')return;if((game.cart[id]||0)>=5){game.feedback='每种商品最多放五件。点购物篮中的 − 可以放回。';game.good=false;render();return}game.cart[id]=(game.cart[id]||0)+1;game.feedback='';render();$('announce').textContent='已添加'+products.find(p=>p.id===id).zh}
function removeItem(id){if(game.stage!=='pack')return;game.cart[id]=Math.max(0,(game.cart[id]||0)-1);game.feedback='';render()}function clearCart(){if(game.stage!=='pack')return;game.cart={};game.feedback='';render()}function toggleHelp(key){game[key]=!game[key];render()}
function recordError(stage,message){game.errors++;saved.errors.push({order:game.index,stage});saved.errors=saved.errors.slice(-30);persist();game.feedback=message;game.good=false;render()}
function checkCart(){if(game.stage!=='pack')return;const o=orders[game.index];const p=products.find(p=>(game.cart[p.id]||0)!==(o.items[p.id]||0));if(p){const required=o.items[p.id]||0,current=game.cart[p.id]||0;recordError('pack',required===0?`这位顾客没有要${p.zh}。请把多放的商品放回。`:`再看看数量：顾客要${required}${p.unit}${p.zh}，购物篮里有${current}${p.unit}。`);return}game.stage='pay';game.feedback='配货正确！接下来，算一算总价。';game.good=true;render()}
function pay(amount){if(game.stage!=='pay')return;const o=orders[game.index],t=total(o.items);if(amount!==t){const detail=products.filter(p=>o.items[p.id]).map(p=>p.price+' × '+o.items[p.id]).join(' + ');recordError('pay',`再算一次：${detail} = ${t}。应收${t}块钱。`);return}game.stage='reply';game.feedback=`收款正确！一共${t}块钱。现在和顾客礼貌告别吧。`;game.good=true;render()}
function reply(which){if(game.stage!=='reply')return;if(which!==1){recordError('reply','顾客说“谢谢”，可以回答“不客气”，再说“欢迎下次再来”。');return}game.stage='reward';game.served++;saved.coins+=10;persist();render();$('announce').textContent='订单完成，获得十金币和一颗星。'}
function nextCustomer(){if(game.stage!=='reward')return;if(game.index===4){game.stage='done';game.active=false;saved.days++;saved.best=Math.max(saved.best,game.served);persist();render();return}game.index++;game.stage='pack';game.cart={};game.feedback='';game.good=false;render()}
function renderDone(){$('speech').textContent='今天辛苦啦，明天见！';$('shopHint').innerHTML='✦ <b>今日营业完成</b> · 小小进步，也值得一颗星';$('panel').innerHTML=`<div class="panel-title"><h2>今日营业手账</h2><span class="day-label">圆满打烊</span></div><div class="welcome"><div class="stars">★★★★★</div><h3>小店长，做得好！</h3><p>完成了 ${game.served} 位顾客的中文购物任务</p><div class="reward">今日赚取 50 金币</div><p>当前余额 ${saved.coins} · 本轮需要重试 ${game.errors} 次<br>星星表示完成任务，不代表首次答题正确率。</p><div class="review-card">会配货：一瓶水、两个苹果<br>会收款：一共……块钱。<br>会送客：不客气，欢迎下次再来！</div><div class="result-actions"><button class="primary" onclick="openDecor()">用金币，装扮我的小店 ✿</button><button class="secondary" onclick="openReview()">看看学习回顾</button><button class="secondary" onclick="startDay()">再开一天，继续练习 →</button></div></div>`}
function openModal(title,body){if($('overlay').hidden)lastFocus=document.activeElement;$('modalTitle').textContent=title;$('modalBody').innerHTML=body;$('overlay').hidden=false;$('overlay').querySelector('.close').focus()}function closeModal(){$('overlay').hidden=true;if(lastFocus&&lastFocus.isConnected)lastFocus.focus()}
function openWords(){openModal('中文小手册','<div class="word-grid">'+products.map(p=>'<article class="word-card">'+productSvg(p.id)+'<strong>'+p.zh+'</strong><div>'+p.py+'</div><small>'+p.th+' · ¥'+p.price+' / '+p.unit+'</small><small>一'+p.unit+p.zh+'</small></article>').join('')+'</div><div class="review-card">我要……：บอกสิ่งที่ต้องการ<br>一共……块钱：บอกราคารวม<br>不客气：ตอบรับคำขอบคุณ<br>提示：数量为二时，商品前常说“两”，例如“两个苹果”。</div>')}
function openDecor(){openModal('装扮我的小店','<div class="decor-icon">'+plantSvg()+'</div><h3 style="text-align:center">窗边的小绿植</h3><p class="modal-note">给认真营业的你，添一点小小的绿意。</p><p class="modal-note">余额：'+saved.coins+' 金币 · 售价：20 金币</p><button class="primary decor-buy" onclick="buyPlant()" '+(saved.plant||saved.coins<20?'disabled':'')+'>'+(saved.plant?'已经摆在店里啦':saved.coins<20?'金币还不够，再接待几位顾客吧':'20 金币 · 带它回店里')+'</button><p class="modal-note">仅为游戏内装饰，无真实付款，也不会提升语言成绩。</p>')}
function buyPlant(){if(saved.plant||saved.coins<20)return;saved.coins-=20;saved.plant=true;persist();render();openDecor();$('announce').textContent='已购买绿植，花费二十金币。'}
function openReview(){const unique=[...new Map(saved.errors.map(e=>[e.order+'-'+e.stage,e])).values()];const label={pack:'配货与数量',pay:'价格计算',reply:'礼貌回应'};openModal('我的学习回顾','<p>已完成营业日：'+saved.days+' · 每日最多接待五位顾客</p>'+(unique.length?'<p class="modal-note">以下是本机记录中需要重试的任务，按顾客与步骤去重。</p>'+unique.map(e=>{const o=orders[e.order];return '<article class="review-card"><strong>顾客 '+(e.order+1)+' · '+label[e.stage]+'</strong><br>'+o.zh+'<br>正确配货：'+itemText(o.items)+'<br>应收：'+total(o.items)+'块钱<br>礼貌回应：不客气，欢迎下次再来！</article>'}).join(''):'<div class="review-card">还没有需要重试的任务记录。开始营业，体验一次完整的购物对话吧。</div>')+'<p class="modal-note">此回顾为固定题库记录，不是综合语言能力评估。最多保留最近30条重试记录。</p>')}
function resetAll(){if(!confirm('确定清除本机金币、装饰和学习记录吗？此操作无法撤销。'))return;saved=defaults();game={active:false,index:0,stage:'welcome',cart:{},served:0,errors:0,py:false,th:false,feedback:'',good:false};persist();closeModal();render()}
document.addEventListener('keydown',e=>{if($('overlay').hidden)return;if(e.key==='Escape'){closeModal();return}if(e.key==='Tab'){const a=[...$('overlay').querySelectorAll('button:not([disabled]),a,input')],first=a[0],last=a[a.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}});$('brandBear').innerHTML=bearSvg();render();
</script></body></html>
